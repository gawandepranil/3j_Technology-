{
  "expo": {
    "name": "3J Technologies",
    "slug": "3j-technologies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "3j",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.3j.technologies"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.j3technologies",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 3JL to access your photos for uploading project files."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76e170cd-b435-4cac-a5b3-891e8c90f0bb"
      }
    }
  }
}
